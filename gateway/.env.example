# Eagle Eye 360 · ATLIP gateway — copy to .env (chmod 600). Never commit the real file.

# Identity — must match a gateway registered in CCTV Surveillance Centre → Gateways
GATEWAY_ID=gw-accra-01
# Public HTTPS hostname that the reverse proxy (Caddy) serves; used only by deploy/Caddyfile
GATEWAY_DOMAIN=gw-accra.infinitytechub.com

# The gateway's own Supabase service account (role "gateway"), created by a Super Administrator
GATEWAY_ACCOUNT_EMAIL=gw-accra-01@gateway.atlip.local
GATEWAY_ACCOUNT_PASSWORD=change-me-long-random

# Secrets — generate with: npm run cli keygen
GATEWAY_VAULT_KEY=
GATEWAY_TICKET_SECRET=

# Platform (public values)
SUPABASE_URL=https://qhyiicwfwbmbkdkpyrnh.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_4Kqw1-U1pJJDGRJXesl3xA_fdAvpFT-
ALLOWED_ORIGINS=https://atlip.infinitytechub.com

# Server
HOST=127.0.0.1
PORT=8090
DATA_DIR=./data
STREAM_DIR=./data/streams

# Streaming
TICKET_TTL_SEC=300
STREAM_IDLE_STOP_SEC=60
HLS_SEGMENT_SEC=1

# Server-side AI (same models as the web app)
AI_ENABLED=true
AI_FPS=1
MODELS_DIR=./models
AI_DETECTOR=atlip-detector-yolo11n.onnx
AI_STATE_MODEL=atlip-state-v2.onnx
AI_DET_CONF=0.3
AI_STATE_CONF=0.7
AI_TEMPORAL_FRAMES=3
MONITOR_INTERVAL_SEC=30
