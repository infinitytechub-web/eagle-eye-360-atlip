# Normalise text to LF in the repository (prevents Windows/macOS line-ending churn when syncing from VS Code)
* text=auto eol=lf

# Windows scripts keep their stored CRLF exactly as-is
*.bat -text
*.cmd -text

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.icns binary
*.woff2 binary
*.onnx binary
*.wasm binary
*.jar binary
*.jks binary
*.keystore binary
