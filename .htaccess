# Eagle Eye 360 — Apache / Hostinger configuration
Options -Indexes
AddType application/manifest+json .webmanifest
AddType application/javascript .js .mjs
AddType application/wasm .wasm
AddType application/octet-stream .onnx
RewriteEngine On

# Never serve hidden files or folders (.git from Hostinger Git deploys, .env, .htaccess) — except ACME .well-known
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Single-page app fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://qhyiicwfwbmbkdkpyrnh.supabase.co; media-src 'self' blob: https://*.infinitytechub.com; connect-src 'self' https://qhyiicwfwbmbkdkpyrnh.supabase.co wss://qhyiicwfwbmbkdkpyrnh.supabase.co https://*.infinitytechub.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

  <FilesMatch "\.(js|mjs|css|png|jpg|svg|woff2|wasm|onnx)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^version\.json$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json application/wasm application/octet-stream
</IfModule>
